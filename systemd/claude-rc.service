# Template: install.sh fills in the @...@ values and writes the result to ~/.config/systemd/user/.
[Unit]
Description=Claude Remote Control server: start sessions on this machine from the Claude phone app
After=graphical-session.target
# At most 5 starts in 10 min; then systemd stops retrying instead of crash-looping into the journal.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
WorkingDirectory=@WORKDIR@
Environment=PATH=@PATH@
Environment=DISPLAY=@DISPLAY@
Environment=WAYLAND_DISPLAY=@WAYLAND_DISPLAY@
ExecStart=@CLAUDE@ remote-control --name @RC_NAME@ --spawn same-dir --capacity 4 --permission-mode auto --chrome
Restart=always
RestartSec=30
# Its stdout is a status display that flooded journald; errors still go to the journal on stderr.
StandardOutput=null

[Install]
WantedBy=default.target
