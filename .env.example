# aos control settings. Copy to .env.local (install.sh does it for you); .env.local is gitignored. Never commit it.
# These keys also go into the Vercel project's environment variables:
#   SUPABASE_URL SUPABASE_SERVICE_ROLE_KEY AOS_MCP_TOKEN CRON_SECRET AOS_DASHBOARD_PASSCODE
#   AOS_OWNER_NAME AOS_OWNERS AOS_VENTURES DISCORD_WEBHOOK_URL

# ---- Required ----
# Supabase project (Project settings > API). The service role key is a secret: server and this PC only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Your deployed app's MCP endpoint and a long random token you make up (openssl rand -hex 32).
AOS_MCP_URL=https://<your-app>.vercel.app/api/mcp
AOS_MCP_TOKEN=
# Vercel cron (morning digest) and dashboard login. Make up both; the passcode needs 8+ characters.
CRON_SECRET=
AOS_DASHBOARD_PASSCODE=

# ---- You ----
# Your name as prompts and the dashboard should use it. Empty: "the user".
AOS_OWNER_NAME=
# Task owners, comma-separated. The first one that is not "claude" is you. Default: me,claude
AOS_OWNERS=
# Where Claude works: the runner's default folder and the Discord agent's folder. Default: your home folder.
AOS_WORKDIR=
# Extra files the unattended runner reads before each task, besides CLAUDE.md (comma-separated, relative to the task folder).
AOS_RUNNER_READ=
# Ventures live in config/ventures.json (copy config/ventures.example.json). On Vercel set AOS_VENTURES to the same
# JSON on one line instead, e.g. the output of: jq -c . config/ventures.json
# AOS_VENTURES=

# ---- Discord (optional, recommended) ----
# Channel webhook for pings and the morning digest (Server settings > Integrations > Webhooks).
DISCORD_WEBHOOK_URL=
# Name for this PC in the Claude app's Remote Control list (install.sh --rc). Default: linux
AOS_RC_NAME=
# A markdown file appended to the Discord agent's system prompt (your own commands and rules).
AOS_AGENT_PROMPT_EXTRA=

# ---- Gemini fallback (optional) ----
# Answers Discord DMs while Claude is at its usage limit or logged out. Either key works.
GEMINI_API_KEY=
VERTEX_PROJECT=

# ---- Runner (optional) ----
# Unattended runs use Chrome with the Claude in Chrome extension. Set 0 to run without a browser (no web tasks).
AOS_RUNNER_CHROME=
# Pause unattended runs before Claude's own limit: max runs and dollars in any 5 hours. Defaults 10 and 15.
AOS_RUNNER_MAX_RUNS_5H=
AOS_RUNNER_MAX_USD_5H=

# ---- Extras for one specific hardware setup (extras/README.md). Leave all of these off. ----
AOS_EXTRA_MPS_FIREWALL=0
AOS_EXTRA_MESH_BACKUP=0
AOS_EXTRA_WATCHERS=0
AOS_EXTRA_UNLOCK=0
AOS_EXTRA_CLOUD=0
# AOS_WATCHERS_DIR=
# AOS_WATCHERS_LABEL=
# AOS_HOME_IP=
# AOS_VM=ubuntu@<VM Tailscale IP>
# MESH_URL=wss://<VM Tailscale IP>:443
# MESH_NODE_ID=
# OCI_NSG_ID=
# OCI_SUBNET_ID=
# OCI_IMAGE_ID=
# OCI_AD=
